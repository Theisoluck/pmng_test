pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = 'pmng'
        COMPOSE_FILE = 'docker-compose.yml'
        ENV_FILE = credentials('pmng_env')
    }

    stages {
        stage('Parar servicio') {
            steps {
                echo 'Parando contenedores...'
                sh '''
                    docker compose -p ${COMPOSE_PROJECT_NAME} \
                    -f ${COMPOSE_FILE} --env-file ${ENV_FILE} down

                    # Contenedores de la app de versiones anteriores del compose (huerfanos).
                    # pmng-mysql no se toca: es la base de datos.
                    for C in pmng-back pmng-cliente pmng-services4; do
                        docker rm -f "$C" 2>/dev/null || true
                    done
                '''
            }
        }

        stage('Eliminar imagenes') {
            steps {
                echo 'Eliminando imagenes antiguas...'
                sh '''
                    IMAGES=$(docker compose -p ${COMPOSE_PROJECT_NAME} \
                    -f ${COMPOSE_FILE} --env-file ${ENV_FILE} config --images | sort -u)

                    for IMAGE in $IMAGES; do
                        echo "Eliminando imagen: $IMAGE"
                        docker rmi "$IMAGE" || true
                    done
                '''
            }
        }

        stage('Construir imagenes') {
            steps {
                echo 'Construyendo imagenes...'
                sh '''
                    docker compose -p ${COMPOSE_PROJECT_NAME} \
                    -f ${COMPOSE_FILE} --env-file ${ENV_FILE} build --no-cache
                '''
            }
        }

        stage('Levantar servicios') {
            steps {
                echo 'Levantando contenedores...'
                sh '''
                    # La red es externa en docker-compose.yml: se crea si aun no existe
                    docker network inspect pmng-net >/dev/null 2>&1 || docker network create pmng-net

                    docker compose -p ${COMPOSE_PROJECT_NAME} \
                    -f ${COMPOSE_FILE} --env-file ${ENV_FILE} up -d
                '''
            }
        }
    }

    post {
        success {
            echo 'Ejecucion del pipeline finalizada con exito.'
        }
        failure {
            echo 'Error en el pipeline. Revisar los logs para mas detalles.'
        }
    }
}
